# War room (app/server.js)
PORT=3000
# Production webhook of the published "Macro Red Team" workflow. Leave empty for the scripted demo.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/macro-red-team
# Optional: defaults to N8N_WEBHOOK_URL with "-investigate" appended to the path.
# N8N_INVESTIGATE_URL=http://localhost:5678/webhook/macro-red-team-investigate
# URL at which n8n can reach this server (http://app:3000 inside docker compose).
PUBLIC_API_BASE=http://localhost:3000
